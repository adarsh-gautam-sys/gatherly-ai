{
  "name": "gatherly-ai-browser-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "prettier --check \"src/gatherly/web/*.{html,css,js}\" \"tests/browser/*.mjs\" playwright.config.mjs package.json",
    "test:unit": "node --test tests/browser/model.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10"
  }
}
