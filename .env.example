# production disables /docs, /redoc and /openapi.json; development enables them.
GATHERLY_ENVIRONMENT=production
# Leave blank to use deterministic fallback. Set a real key only in your local environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GATHERLY_AI_TIMEOUT_SECONDS=6
GATHERLY_AI_CONCURRENCY=4
GATHERLY_CACHE_CAPACITY=128
GATHERLY_CACHE_TTL_SECONDS=300
